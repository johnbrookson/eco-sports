{
  "name": "web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx -y firebase-tools@15 emulators:exec --only dataconnect --project demo-basketball-net \"npm run seed:data && vitest run\"",
    "emulators": "npx -y firebase-tools@15 emulators:start --only auth,dataconnect --project demo-basketball-net",
    "seed:auth": "node scripts/seed-demo-users.mjs",
    "seed:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-data.mjs",
    "dataconnect:generate": "npx -y firebase-tools@15 dataconnect:sdk:generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@basketball-net/dataconnect": "file:src/dataconnect-generated",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^13.10.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
